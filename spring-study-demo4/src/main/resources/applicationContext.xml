    <!--
        context:component-scan标签：定义包扫描的规则，告诉spring要去指定的包下面扫描所属的类
            base-package属性：描述的是扫描指定的包及其子包下面的所有类
    -->
    <context:component-scan base-package="com.sonnet"></context:component-scan>
</beans>